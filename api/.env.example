# KatPay Payment Gateway
KATPAY_PUBLIC_KEY=your_katpay_public_key_here
KATPAY_SECRET_KEY=your_katpay_secret_key_here
KATPAY_MERCHANT_ID=your_katpay_merchant_id_here
