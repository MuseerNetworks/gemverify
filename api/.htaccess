<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# Disable Directory Listings
Options -Indexes

# Suppress PHP Error Outputs
php_flag display_errors Off
php_flag log_errors On

RewriteEngine On

# Pass Authorization and KatPay headers to PHP in CGI/FastCGI environments (cPanel/Apache)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
SetEnvIf X-KatPay-Signature "(.*)" HTTP_X_KATPAY_SIGNATURE=$1
SetEnvIf X-KatPay-Timestamp "(.*)" HTTP_X_KATPAY_TIMESTAMP=$1
SetEnvIf X-KatPay-Delivery-ID "(.*)" HTTP_X_KATPAY_DELIVERY_ID=$1
SetEnvIf X-KatPay-Event "(.*)" HTTP_X_KATPAY_EVENT=$1

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
