# Disable directory index listings site-wide
Options -Indexes

# ── GZIP Compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    AddOutputFilterByType DEFLATE application/json text/plain application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
    # Remove browser bugs (for ancient browsers — safe to include)
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    Header append Vary User-Agent
</IfModule>

# ── Browser Caching for Static Assets (1 Year) ────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/jpg              "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
</IfModule>

# ── Cache-Control Headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # HTML/PHP: allow conditional revalidation (304 Not Modified on repeat visits)
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset Pragma
        Header unset Expires
    </FilesMatch>
    # Static assets: 1-year cache (safe — these files change rarely)
    <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|css|js|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
